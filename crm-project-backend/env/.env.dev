DJANGO_SETTINGS_MODULE=krishna_air.settings.dev

# Secret Key
SECRET_KEY=your_secret_key

# Keep False for production.
# For local development you can temporarily change it to True if needed.
DEBUG=False

# Frontend URL (used for password reset emails)
FRONTEND_URL=https://teimsafety.com/password-reset-confirm

# Allow both local and live domains
ALLOWED_HOSTS=localhost,127.0.0.1,teimsafety.com,www.teimsafety.com

# Allow frontend from both local and production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://teimsafety.com,https://www.teimsafety.com

# CSRF trusted origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://teimsafety.com,https://www.teimsafety.com

# Email
EMAIL_HOST_USER=enter_ur_email
EMAIL_HOST_PASSWORD=enter_ur_password

# Google OAuth
GOOGLE_CALLBACK_URL=https://teimsafety.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# CORS
CORS_ALLOW_ALL_ORIGINS=False